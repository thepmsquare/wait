# Django
# Keep DEBUG=true for local development only. Production must use false.
DEBUG=true
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=wait.thepmsquare.com,localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=https://wait.thepmsquare.com

# Database
DB_NAME=wait
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Google OAuth Credentials (for allauth)
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-secret

# Email (optional; allauth password reset uses the console backend by default)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=wait@thepmsquare.com

# CORS (optional; only wide open when DEBUG=true)
# CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=https://wait.thepmsquare.com

# Deployment (optional)
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=60
# PORT=30001
# RUN_MIGRATIONS=1
